%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 361f528868d087140b8fdd933fe7ad92, type: 3}
  m_Name: DataDialogLanguage
  m_EditorClassIdentifier: Assembly-CSharp::DataDialogLanguage
  itemSettings:
  - DialogueName: ChrisTurner_The Goodfather
    Id: 1
    En_DialogLines:
    - <Character>k__BackingField: Chris Turner
      <Line>k__BackingField: 'Hey, Ray! Heard you''re going on holiday, so I wanted
        to drop off The Goodfather before you leave. '
      IdNumber: 1
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'The Goodfather? Is that the one where they make you
        an offer you actually can refuse? '
      IdNumber: 2
    - <Character>k__BackingField: Chris Turner
      <Line>k__BackingField: 'Exactly. Nobody gets threatened. Nobody wakes up with
        a horse''s head in their bed. '
      IdNumber: 3
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Sounds like the family finally worked on its communication
        skills. '
      IdNumber: 4
    - <Character>k__BackingField: Chris Turner
      <Line>k__BackingField: 'Yeah. By the way, I bought a new stereo yesterday,
        so I''ll leave my old boombox by the return box near the door. '
      IdNumber: 5
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'You replace electronics faster than I rewind tapes. '
      IdNumber: 6
    - <Character>k__BackingField: Chris Turner
      <Line>k__BackingField: 'Technology waits for no one. '
      IdNumber: 7
    Rus_DialogLines:
    - <Character>k__BackingField: "\u041A\u0440\u0438\u0441 \u0422\u0451\u0440\u043D\u0435\u0440"
      <Line>k__BackingField: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0420\u044D\u0439!
        \u0421\u043B\u044B\u0448\u0430\u043B, \u0442\u044B \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C\u0441\u044F
        \u0432 \u043E\u0442\u043F\u0443\u0441\u043A. \u0420\u0435\u0448\u0438\u043B
        \u0432\u0435\u0440\u043D\u0443\u0442\u044C \xAB\u0425\u043E\u0440\u043E\u0448\u0435\u0433\u043E
        \u043E\u0442\u0446\u0430\xBB, \u043F\u043E\u043A\u0430 \u0442\u044B \u043D\u0435
        \u0443\u0435\u0445\u0430\u043B. "
      IdNumber: 1
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\xAB\u0425\u043E\u0440\u043E\u0448\u0435\u0433\u043E
        \u043E\u0442\u0446\u0430\xBB? \u042D\u0442\u043E \u0433\u0434\u0435 \u0442\u0435\u0431\u0435
        \u0434\u0435\u043B\u0430\u044E\u0442 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435,
        \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0432\u043F\u043E\u043B\u043D\u0435
        \u043C\u043E\u0436\u043D\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F? "
      IdNumber: 2
    - <Character>k__BackingField: "\u041A\u0440\u0438\u0441 \u0422\u0451\u0440\u043D\u0435\u0440"
      <Line>k__BackingField: "\u0410\u0433\u0430. \u041D\u0438\u043A\u043E\u043C\u0443
        \u043D\u0435 \u0443\u0433\u0440\u043E\u0436\u0430\u044E\u0442. \u0418 \u043D\u0438\u043A\u0442\u043E
        \u043D\u0435 \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F
        \u0441 \u043B\u043E\u0448\u0430\u0434\u0438\u043D\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
        \u0432 \u043F\u043E\u0441\u0442\u0435\u043B\u0438. "
      IdNumber: 3
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u041F\u043E\u0445\u043E\u0436\u0435, \u043E\u043D\u0438
        \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u043D\u0430\u0443\u0447\u0438\u043B\u0438\u0441\u044C
        \u0440\u0435\u0448\u0430\u0442\u044C \u0432\u0441\u0451 \u0441\u043B\u043E\u0432\u0430\u043C\u0438. "
      IdNumber: 4
    - <Character>k__BackingField: "\u041A\u0440\u0438\u0441 \u0422\u0451\u0440\u043D\u0435\u0440"
      <Line>k__BackingField: "\u0410\u0433\u0430. \u041A\u0441\u0442\u0430\u0442\u0438,
        \u044F \u0432\u0447\u0435\u0440\u0430 \u043A\u0443\u043F\u0438\u043B \u043D\u043E\u0432\u0443\u044E
        \u0441\u0442\u0435\u0440\u0435\u043E\u0441\u0438\u0441\u0442\u0435\u043C\u0443,
        \u0442\u0430\u043A \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044E
        \u0441\u0432\u043E\u0439 \u0441\u0442\u0430\u0440\u044B\u0439 \u043C\u0430\u0433\u043D\u0438\u0442\u043E\u0444\u043E\u043D
        \u0443 \u043A\u043E\u0440\u043E\u0431\u043A\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430
        \u0432\u043E\u0437\u043B\u0435 \u0434\u0432\u0435\u0440\u0438. "
      IdNumber: 5
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u0422\u044B \u0442\u0435\u0445\u043D\u0438\u043A\u0443
        \u043C\u0435\u043D\u044F\u0435\u0448\u044C \u0447\u0430\u0449\u0435, \u0447\u0435\u043C
        \u044F \u043A\u0430\u0441\u0441\u0435\u0442\u044B \u043F\u0435\u0440\u0435\u043C\u0430\u0442\u044B\u0432\u0430\u044E. "
      IdNumber: 6
    - <Character>k__BackingField: "\u041A\u0440\u0438\u0441 \u0422\u0451\u0440\u043D\u0435\u0440"
      <Line>k__BackingField: "\u041F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u043D\u0435
        \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. "
      IdNumber: 7
  - DialogueName: NancyParker_The Announcement
    Id: 2
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Video Rental, Ray speaking. '
      IdNumber: 1
    - <Character>k__BackingField: Nancy Parker
      <Line>k__BackingField: "Ray-Ray-Sun Ray! I\u2019m bringing back another episode
        of Sunset Creek. "
      IdNumber: 2
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Hi, Nanc! Another one? Does that show ever actually
        end? '
      IdNumber: 3
    - <Character>k__BackingField: Nancy Parker
      <Line>k__BackingField: 'Not while they still have secrets to reveal and marriages
        to ruin. Anyway, have a good trip and bring me a souvenir. Something with
        a good story behind it. '
      IdNumber: 4
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "I\u2019ll do my best. "
      IdNumber: 5
    Rus_DialogLines:
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u0412\u0438\u0434\u0435\u043E\u043F\u0440\u043E\u043A\u0430\u0442,
        \u0420\u044D\u0439 \u043D\u0430 \u0441\u0432\u044F\u0437\u0438. "
      IdNumber: 1
    - <Character>k__BackingField: "\u041D\u044D\u043D\u0441\u0438 \u041F\u0430\u0440\u043A\u0435\u0440"
      <Line>k__BackingField: "\u0420\u044D\u0439, \u0434\u043E\u0440\u043E\u0433\u043E\u0439!
        \u041D\u0435\u0441\u0443 \u0442\u0435\u0431\u0435 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u0443\u044E
        \u0441\u0435\u0440\u0438\u044E \xAB\u0421\u0430\u043D\u0441\u0435\u0442-\u041A\u0440\u0438\u043A\xBB. "
      IdNumber: 2
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u041F\u0440\u0438\u0432\u0435\u0442, \u041D\u044D\u043D\u0441!
        \u0415\u0449\u0451 \u043E\u0434\u043D\u0443? \u042D\u0442\u043E\u0442 \u0441\u0435\u0440\u0438\u0430\u043B
        \u0432\u043E\u043E\u0431\u0449\u0435 \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C
        \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F? "
      IdNumber: 3
    - <Character>k__BackingField: "\u041D\u044D\u043D\u0441\u0438 \u041F\u0430\u0440\u043A\u0435\u0440"
      <Line>k__BackingField: "\u041D\u0435 \u0440\u0430\u043D\u044C\u0448\u0435,
        \u0447\u0435\u043C \u0443 \u043D\u0438\u0445 \u0437\u0430\u043A\u043E\u043D\u0447\u0430\u0442\u0441\u044F
        \u0441\u0435\u043A\u0440\u0435\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044C,
        \u0438 \u0431\u0440\u0430\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u044C.
        \u041B\u0430\u0434\u043D\u043E, \u0445\u043E\u0440\u043E\u0448\u0435\u0439
        \u043F\u043E\u0435\u0437\u0434\u043A\u0438! \u0418 \u043F\u0440\u0438\u0432\u0435\u0437\u0438
        \u043C\u043D\u0435 \u0441\u0443\u0432\u0435\u043D\u0438\u0440. \u0422\u043E\u043B\u044C\u043A\u043E
        \u0447\u0442\u043E\u0431\u044B \u0441 \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439. "
      IdNumber: 4
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u041F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C. "
      IdNumber: 5
  - DialogueName: Danny Collins_Big Trouble in Little China
    Id: 3
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Ray speaking. '
      IdNumber: 1
    - <Character>k__BackingField: Danny Collins
      <Line>k__BackingField: "Hi, Ray! It's Danny. I\u2019m returning Little Trouble
        in Big China. "
      IdNumber: 2
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Hi, kid! Little Trouble? I remember that being quite
        a lot of trouble. '
      IdNumber: 3
    - <Character>k__BackingField: Danny Collins
      <Line>k__BackingField: 'Maybe the trouble was little, but there was just a
        lot of it. '
      IdNumber: 4
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "I suppose that\u2019s one way to look at it. "
      IdNumber: 5
    - <Character>k__BackingField: Danny Collins
      <Line>k__BackingField: 'See? The title makes sense! '
      IdNumber: 6
    Rus_DialogLines:
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u0420\u044D\u0439 \u043D\u0430 \u0441\u0432\u044F\u0437\u0438. "
      IdNumber: 1
    - <Character>k__BackingField: "\u0414\u044D\u043D\u043D\u0438 \u041A\u043E\u043B\u043B\u0438\u043D\u0437"
      <Line>k__BackingField: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0420\u044D\u0439!
        \u042D\u0442\u043E \u0414\u044D\u043D\u043D\u0438. \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E
        \xAB\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438
        \u0432 \u0411\u043E\u043B\u044C\u0448\u043E\u043C \u041A\u0438\u0442\u0430\u0435\xBB. "
      IdNumber: 2
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043C\u0430\u043B\u043E\u0439!
        \xAB\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438\xBB?
        \u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u044F \u043F\u043E\u043C\u043D\u044E,
        \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0435\u0439
        \u0442\u0430\u043C \u0431\u044B\u043B\u043E \u0445\u043E\u0442\u044C \u043E\u0442\u0431\u0430\u0432\u043B\u044F\u0439. "
      IdNumber: 3
    - <Character>k__BackingField: "\u0414\u044D\u043D\u043D\u0438 \u041A\u043E\u043B\u043B\u0438\u043D\u0437"
      <Line>k__BackingField: "\u0422\u0430\u043A \u043E\u043D\u0438 \u0438 \u0431\u044B\u043B\u0438
        \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435. \u041F\u0440\u043E\u0441\u0442\u043E
        \u0438\u0445 \u0431\u044B\u043B\u043E \u043E\u0447\u0435\u043D\u044C \u043C\u043D\u043E\u0433\u043E. "
      IdNumber: 4
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u041D\u0443, \u0435\u0441\u043B\u0438 \u0442\u0430\u043A
        \u043D\u0430 \u044D\u0442\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C... "
      IdNumber: 5
    - <Character>k__BackingField: "\u0414\u044D\u043D\u043D\u0438 \u041A\u043E\u043B\u043B\u0438\u043D\u0437"
      <Line>k__BackingField: "\u0412\u043E\u0442 \u0432\u0438\u0434\u0438\u0448\u044C!
        \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435-\u0442\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435! "
      IdNumber: 6
  - DialogueName: Ray_Intro
    Id: 4
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Damn... '
      IdNumber: 1
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Raccoons. Every damn time. '
      IdNumber: 2
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u0427\u0451\u0440\u0442... "
      IdNumber: 1
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u0415\u043D\u043E\u0442\u044B. \u041D\u0443 \u043A\u043E\u043D\u0435\u0447\u043D\u043E. "
      IdNumber: 2
  - DialogueName: Ray_Post_Intro
    Id: 5
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'I should probably clean this place up before I leave. '
      IdNumber: 1
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u041D\u0430\u0434\u043E \u0431\u044B \u043F\u0440\u0438\u0431\u0440\u0430\u0442\u044C\u0441\u044F
        \u043F\u0435\u0440\u0435\u0434 \u043E\u0442\u044A\u0435\u0437\u0434\u043E\u043C. "
      IdNumber: 1
  - DialogueName: Ray_PickUp
    Id: 6
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Okay. Let''s start with this one. '
      IdNumber: 1
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u0427\u0442\u043E \u0436. \u041D\u0430\u0447\u043D\u0451\u043C
        \u0441 \u0442\u0435\u0431\u044F. "
      IdNumber: 1
  - DialogueName: Ray_Correct_Install
    Id: 7
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'There we go. '
      IdNumber: 1
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u0412\u043E\u0442 \u0442\u0430\u043A. "
      IdNumber: 1
  - DialogueName: Ray_PickUp_Opera
    Id: 8
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Huh. No episode number. '
      IdNumber: 1
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Fine. Let''s see this "masterpiece". '
      IdNumber: 2
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u0425\u043C. \u041D\u043E\u043C\u0435\u0440\u0430
        \u0441\u0435\u0440\u0438\u0438 \u043D\u0435\u0442. "
      IdNumber: 1
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u041F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
        \u044D\u0442\u043E\u0442 \xAB\u0448\u0435\u0434\u0435\u0432\u0440\xBB. "
      IdNumber: 2
  - DialogueName: Ray_Ring
    Id: 9
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Seriously? Right now? '
      IdNumber: 1
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u0421\u0435\u0440\u044C\u0451\u0437\u043D\u043E? \u041F\u0440\u044F\u043C\u043E
        \u0441\u0435\u0439\u0447\u0430\u0441? "
      IdNumber: 1
  - DialogueName: Ray_Returned
    Id: 10
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Let''s see what Chris left by the door. '
      IdNumber: 1
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
        \u0447\u0442\u043E \u041A\u0440\u0438\u0441 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
        \u0443 \u0434\u0432\u0435\u0440\u0438. "
      IdNumber: 1
  - DialogueName: Ray_PickUp_Present
    Id: 11
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Cleaning might be better with some music. '
      IdNumber: 1
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u0421 \u043C\u0443\u0437\u044B\u043A\u043E\u0439 \u0445\u043E\u0442\u044C
        \u0432\u0435\u0441\u0435\u043B\u0435\u0435 \u0431\u0443\u0434\u0435\u0442
        \u0443\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F. "
      IdNumber: 1
  - DialogueName: Ray_Install_Present
    Id: 12
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Let''s see if this thing still works. '
      IdNumber: 1
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
        \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043B\u0438 \u043E\u043D
        \u0432\u043E\u043E\u0431\u0449\u0435. "
      IdNumber: 1
  - DialogueName: Ray_Play_Music
    Id: 13
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Much better. '
      IdNumber: 1
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u0422\u0430\u043A-\u0442\u043E \u043B\u0443\u0447\u0448\u0435. "
      IdNumber: 1
  - DialogueName: Ray_Cat_Name
    Id: 14
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Louie. '
      IdNumber: 1
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u041B\u0443\u0438. "
      IdNumber: 1
  - DialogueName: Ray_Cat_Question
    Id: 15
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'You let the raccoons trash the place? '
      IdNumber: 1
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u0422\u044B \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B
        \u0435\u043D\u043E\u0442\u0430\u043C \u0440\u0430\u0437\u0433\u0440\u043E\u043C\u0438\u0442\u044C
        \u043C\u0430\u0433\u0430\u0437\u0438\u043D? "
      IdNumber: 1
  - DialogueName: Ray_Cat_Meow
    Id: 16
    En_DialogLines:
    - <Character>k__BackingField: Louie
      <Line>k__BackingField: 'Meow. '
      IdNumber: 1
    Rus_DialogLines:
    - <Character>k__BackingField: Louie
      <Line>k__BackingField: "\u041C\u044F\u0443. "
      IdNumber: 1
  - DialogueName: Ray_Cat_Fired
    Id: 17
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Fired. '
      IdNumber: 1
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u0423\u0432\u043E\u043B\u0435\u043D. "
      IdNumber: 1
  - DialogueName: Ray_End
    Id: 18
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Good enough. Come on, Louie. We''ve earned ourselves
        a vacation. '
      IdNumber: 1
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Come on, Louie. We''ve earned ourselves a vacation. '
      IdNumber: 2
    Rus_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u041D\u0443, \u0441\u043E\u0439\u0434\u0451\u0442.
        \u041F\u043E\u0439\u0434\u0451\u043C, \u041B\u0443\u0438. \u041C\u044B \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u043B\u0438
        \u043E\u0442\u043F\u0443\u0441\u043A. "
      IdNumber: 1
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "\u041F\u043E\u0439\u0434\u0451\u043C, \u041B\u0443\u0438.
        \u041C\u044B \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u043B\u0438 \u043E\u0442\u043F\u0443\u0441\u043A. "
      IdNumber: 2
