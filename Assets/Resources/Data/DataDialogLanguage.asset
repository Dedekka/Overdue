%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 361f528868d087140b8fdd933fe7ad92, type: 3}
  m_Name: DataDialogLanguage
  m_EditorClassIdentifier: Assembly-CSharp::DataDialogLanguage
  itemSettings:
  - DialogueName: ChrisTurner_The Goodfather
    Id: 1
    En_DialogLines:
    - <Character>k__BackingField: Chris Turner
      <Line>k__BackingField: 'Hey, Ray! Heard you''re going on holiday, so I wanted
        to drop off The Goodfather before you leave. '
      IdNumber: 1
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'The Goodfather? Is that the one where they make you
        an offer you actually can refuse? '
      IdNumber: 2
    - <Character>k__BackingField: Chris Turner
      <Line>k__BackingField: 'Exactly. Nobody gets threatened. Nobody wakes up with
        a horse''s head in their bed. '
      IdNumber: 3
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Sounds like the family finally worked on its communication
        skills. '
      IdNumber: 4
    - <Character>k__BackingField: Chris Turner
      <Line>k__BackingField: 'Yeah. By the way, I bought a new stereo yesterday,
        so I''ll leave my old boombox by the return box near the door. '
      IdNumber: 5
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'You replace electronics faster than I rewind tapes. '
      IdNumber: 6
    - <Character>k__BackingField: Chris Turner
      <Line>k__BackingField: 'Technology waits for no one. '
      IdNumber: 7
    Rus_DialogLines:
    - <Character>k__BackingField: "\u041A\u0440\u0438\u0441 \u0422\u0435\u0440\u043D\u0435\u0440"
      <Line>k__BackingField: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0420\u044D\u0439!
        \u0421\u043B\u044B\u0448\u0430\u043B, \u0442\u044B \u0443\u0435\u0437\u0436\u0430\u0435\u0448\u044C
        \u0432 \u043E\u0442\u043F\u0443\u0441\u043A, \u0438 \u044F \u0445\u043E\u0442\u0435\u043B
        \u0437\u0430\u0432\u0435\u0437\u0442\u0438 \u0442\u0435\u0431\u0435 \"\u0414\u043E\u0431\u0440\u043E\u0433\u043E
        \u043E\u0442\u0446\u0430\", \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C
        \u0442\u044B \u0443\u0435\u0434\u0435\u0448\u044C. "
      IdNumber: 1
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u0414\u043E\u0431\u0440\u044B\u0439 \u043E\u0442\u0435\u0446?
        \u042D\u0442\u043E \u0442\u043E\u0442 \u0441\u043B\u0443\u0447\u0430\u0439,
        \u043A\u043E\u0433\u0434\u0430 \u0442\u0435\u0431\u0435 \u0434\u0435\u043B\u0430\u044E\u0442
        \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435, \u043E\u0442
        \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0442\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043C\u043E\u0436\u0435\u0448\u044C \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F? "
      IdNumber: 2
    - <Character>k__BackingField: "\u041A\u0440\u0438\u0441 \u0422\u0435\u0440\u043D\u0435\u0440"
      <Line>k__BackingField: "\u0418\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043A.
        \u041D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u0443\u0433\u0440\u043E\u0436\u0430\u044E\u0442.
        \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F
        \u0441 \u043B\u043E\u0448\u0430\u0434\u0438\u043D\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
        \u0432 \u0441\u0432\u043E\u0435\u0439 \u043F\u043E\u0441\u0442\u0435\u043B\u0438. "
      IdNumber: 3
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0441\u0435\u043C\u044C\u044F
        \u043D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E \u043F\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430
        \u043D\u0430\u0434 \u0441\u0432\u043E\u0438\u043C\u0438 \u043A\u043E\u043C\u043C\u0443\u043D\u0438\u043A\u0430\u0442\u0438\u0432\u043D\u044B\u043C\u0438
        \u043D\u0430\u0432\u044B\u043A\u0430\u043C\u0438. "
      IdNumber: 4
    - <Character>k__BackingField: "\u041A\u0440\u0438\u0441 \u0422\u0435\u0440\u043D\u0435\u0440"
      <Line>k__BackingField: "\u0414\u0430. \u041A\u0441\u0442\u0430\u0442\u0438,
        \u0432\u0447\u0435\u0440\u0430 \u044F \u043A\u0443\u043F\u0438\u043B \u043D\u043E\u0432\u0443\u044E
        \u0441\u0442\u0435\u0440\u0435\u043E\u0441\u0438\u0441\u0442\u0435\u043C\u0443,
        \u0442\u0430\u043A \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044E
        \u0441\u0432\u043E\u0439 \u0441\u0442\u0430\u0440\u044B\u0439 \u0431\u0443\u043C\u0431\u043E\u043A\u0441
        \u0432 \u044F\u0449\u0438\u043A\u0435 \u0434\u043B\u044F \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430
        \u0432\u043E\u0437\u043B\u0435 \u0434\u0432\u0435\u0440\u0438. "
      IdNumber: 5
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u0422\u044B \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0448\u044C
        \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0438\u043A\u0443 \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
        \u0447\u0435\u043C \u044F \u043F\u0435\u0440\u0435\u043C\u0430\u0442\u044B\u0432\u0430\u044E
        \u043A\u0430\u0441\u0441\u0435\u0442\u044B. "
      IdNumber: 6
    - <Character>k__BackingField: "\u041A\u0440\u0438\u0441 \u0422\u0435\u0440\u043D\u0435\u0440"
      <Line>k__BackingField: "\u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F
        \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u0436\u0434\u0435\u0442. "
      IdNumber: 7
  - DialogueName: NancyParker_The Announcement
    Id: 2
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Video Rental, Ray speaking. '
      IdNumber: 1
    - <Character>k__BackingField: Nancy Parker
      <Line>k__BackingField: "Ray-Ray-Sun Ray! I\u2019m bringing back another episode
        of Sunset Creek. "
      IdNumber: 2
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Hi, Nanc! Another one? Does that show ever actually
        end? '
      IdNumber: 3
    - <Character>k__BackingField: Nancy Parker
      <Line>k__BackingField: 'Not while they still have secrets to reveal and marriages
        to ruin. Anyway, have a good trip and bring me a souvenir. Something with
        a good story behind it. '
      IdNumber: 4
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "I\u2019ll do my best. "
      IdNumber: 5
    Rus_DialogLines:
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u0412\u0438\u0434\u0435\u043E\u043F\u0440\u043E\u043A\u0430\u0442,
        \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0420\u044D\u0439. "
      IdNumber: 1
    - <Character>k__BackingField: "\u041D\u044D\u043D\u0441\u0438 \u041F\u0430\u0440\u043A\u0435\u0440"
      <Line>k__BackingField: "\u0420\u044D\u0439-\u0420\u044D\u0439-\u0420\u044D\u0439
        \u0421\u043E\u043B\u043D\u0446\u0430! \u042F \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E
        \u0432\u0430\u043C \u0435\u0449\u0435 \u043E\u0434\u043D\u0443 \u0441\u0435\u0440\u0438\u044E
        \"\u0421\u0430\u043D\u0441\u0435\u0442 \u041A\u0440\u0438\u043A\". "
      IdNumber: 2
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u041F\u0440\u0438\u0432\u0435\u0442, \u041D\u044D\u043D\u0441\u0438!
        \u0415\u0449\u0435 \u043E\u0434\u043D\u043E? \u042D\u0442\u043E \u0448\u043E\u0443
        \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F? "
      IdNumber: 3
    - <Character>k__BackingField: "\u041D\u044D\u043D\u0441\u0438 \u041F\u0430\u0440\u043A\u0435\u0440"
      <Line>k__BackingField: "\u041D\u0435\u0442, \u043F\u043E\u043A\u0430 \u0443
        \u043D\u0438\u0445 \u0435\u0449\u0435 \u0435\u0441\u0442\u044C \u0441\u0435\u043A\u0440\u0435\u0442\u044B,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0443\u0436\u043D\u043E
        \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044C, \u0438 \u0431\u0440\u0430\u043A\u0438,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u0443\u0442
        \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u044C\u0441\u044F. \u0412
        \u043B\u044E\u0431\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435, \u0443\u0434\u0430\u0447\u043D\u043E\u0439
        \u043F\u043E\u0435\u0437\u0434\u043A\u0438 \u0438 \u043F\u0440\u0438\u0432\u0435\u0437\u0438
        \u043C\u043D\u0435 \u0441\u0443\u0432\u0435\u043D\u0438\u0440. \u0427\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
        \u0441 \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439. "
      IdNumber: 4
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u042F \u0441\u0434\u0435\u043B\u0430\u044E \u0432\u0441\u0435,
        \u0447\u0442\u043E \u0432 \u043C\u043E\u0438\u0445 \u0441\u0438\u043B\u0430\u0445. "
      IdNumber: 5
  - DialogueName: Danny Collins_Big Trouble in Little China
    Id: 3
    En_DialogLines:
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Ray speaking. '
      IdNumber: 1
    - <Character>k__BackingField: Danny Collins
      <Line>k__BackingField: "Hi, Ray! It's Danny. I\u2019m returning Little Trouble
        in Big China. "
      IdNumber: 2
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: 'Hi, kid! Little Trouble? I remember that being quite
        a lot of trouble. '
      IdNumber: 3
    - <Character>k__BackingField: Danny Collins
      <Line>k__BackingField: 'Maybe the trouble was little, but there was just a
        lot of it. '
      IdNumber: 4
    - <Character>k__BackingField: Ray
      <Line>k__BackingField: "I suppose that\u2019s one way to look at it. "
      IdNumber: 5
    - <Character>k__BackingField: Danny Collins
      <Line>k__BackingField: 'See? The title makes sense! '
      IdNumber: 6
    Rus_DialogLines:
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u0420\u044D\u0439 \u0441\u043B\u0443\u0448\u0430\u0435\u0442. "
      IdNumber: 1
    - <Character>k__BackingField: "\u0414\u044D\u043D\u043D\u0438 \u041A\u043E\u043B\u043B\u0438\u043D\u0437"
      <Line>k__BackingField: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0420\u044D\u0439!
        \u042D\u0442\u043E \u0414\u044D\u043D\u043D\u0438. \u042F \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0441\u044C
        \u0432 \"\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438
        \u0432 \u0411\u043E\u043B\u044C\u0448\u043E\u043C \u041A\u0438\u0442\u0430\u0435\". "
      IdNumber: 2
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043C\u0430\u043B\u044B\u0448!
        \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438?
        \u042F \u043F\u043E\u043C\u043D\u044E, \u0447\u0442\u043E \u044D\u0442\u043E
        \u0431\u044B\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438. "
      IdNumber: 3
    - <Character>k__BackingField: "\u0414\u044D\u043D\u043D\u0438 \u041A\u043E\u043B\u043B\u0438\u043D\u0437"
      <Line>k__BackingField: "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C,
        \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u0438 \u0431\u044B\u043B\u0430
        \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439, \u043D\u043E \u0435\u0435
        \u0431\u044B\u043B\u043E \u043E\u0447\u0435\u043D\u044C \u043C\u043D\u043E\u0433\u043E. "
      IdNumber: 4
    - <Character>k__BackingField: "\u0420\u044D\u0439"
      <Line>k__BackingField: "\u042F \u043F\u043E\u043B\u0430\u0433\u0430\u044E,
        \u044D\u0442\u043E \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u0432
        \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u0442\u044C \u043D\u0430 \u044D\u0442\u043E. "
      IdNumber: 5
    - <Character>k__BackingField: "\u0414\u044D\u043D\u043D\u0438 \u041A\u043E\u043B\u043B\u0438\u043D\u0437"
      <Line>k__BackingField: "\u0412\u0438\u0434\u0438\u0442\u0435? \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
        \u0438\u043C\u0435\u0435\u0442 \u0441\u043C\u044B\u0441\u043B! "
      IdNumber: 6
