  _dialogues:
  - DialogueName: ChrisTurner_TheSilenceOfTheLambs
    Id: 1
    NameCharacter: ChrisTurner
    Original_Title: The Silence of the Lambs
    Present: "\u041C\u0430\u0433\u043D\u0438\u0442\u043E\u0444\u043E\u043D"
    DialogLines:
    - Character: Ray
      IdNumber: 1
      Line: 'Video Rental, Ray speaking. '
      SoundLine: event:/Dialogs/ChrisTurner_TheSilenceOfTheLambs/1
    - Character: Chris
      IdNumber: 2
      Line: 'Hey, Ray! Glad to hear you''re back. I was starting to think this town
        had lost its last good video store. Anyway, I found your copy of The Silence
        of the Lamps. '
      SoundLine: event:/Dialogs/ChrisTurner_TheSilenceOfTheLambs/2
    - Character: Ray
      IdNumber: 3
      Line: 'So... nobody turned the lights on? '
      SoundLine: event:/Dialogs/ChrisTurner_TheSilenceOfTheLambs/1
    - Character: Chris
      IdNumber: 4
      Line: 'Pretty much. Three hours of people whispering in the dark. I bought
        a new stereo yesterday, so I''ll leave my old boombox in the return box too. '
      SoundLine: event:/Dialogs/ChrisTurner_TheSilenceOfTheLambs/2
    - Character: Ray
      IdNumber: 5
      Line: 'You replace electronics faster than I rewind tapes. '
      SoundLine: event:/Dialogs/ChrisTurner_TheSilenceOfTheLambs/1
    - Character: Chris
      IdNumber: 6
      Line: 'Technology waits for no one. '
      SoundLine: event:/Dialogs/ChrisTurner_TheSilenceOfTheLambs/2
    DialogueEventData:
      IdEvent: 1
      DialogueName: ChrisTurner_TheSilenceOfTheLambs
      IDCassette: 55
      IDPresent: 1
  - DialogueName: NancyParker_TheGodfather
    Id: 2
    NameCharacter: NancyParker
    Original_Title: The Godfather
    Present: '-'
    DialogLines:
    - Character: Ray
      IdNumber: 1
      Line: 'Hello! Video Renta. '
      SoundLine: event:/Dialogs/NancyParker_TheGodfather/1
    - Character: Nancy
      IdNumber: 2
      Line: 'Ray! I''m bringing back The Codfather. '
      SoundLine: event:/Dialogs/NancyParker_TheGodfather/2
    - Character: Ray
      IdNumber: 3
      Line: 'Fish mafia? '
      SoundLine: event:/Dialogs/NancyParker_TheGodfather/1
    - Character: Nancy
      IdNumber: 4
      Line: 'You''d better not sleep with the tuna. '
      SoundLine: event:/Dialogs/NancyParker_TheGodfather/2
    - Character: Ray
      IdNumber: 5
      Line: 'Sounds... suspiciously familiar. '
      SoundLine: event:/Dialogs/NancyParker_TheGodfather/1
    - Character: Nancy
      IdNumber: 6
      Line: 'I''ll drop it in the return box in a few minutes. '
      SoundLine: event:/Dialogs/NancyParker_TheGodfather/2
    DialogueEventData:
      IdEvent: 2
      DialogueName: NancyParker_TheGodfather
      IDCassette: 25
      IDPresent: 5
  - DialogueName: "\u041F\u043E\u0441\u0442\u0435\u0440\u044B"
    Id: 3
    NameCharacter: NancyParker
    Original_Title: The Godfather
    Present: '-'
    DialogLines:
    - Character: Ray
      IdNumber: 1
      Line: "Hello! Give me \u041F\u043E\u0441\u0442\u0435\u0440\u044B "
      SoundLine: event:/Dialogs/NancyParker_TheGodfather/1
    - Character: Nancy
      IdNumber: 2
      Line: Ok
      SoundLine: event:/Dialogs/NancyParker_TheGodfather/2
    DialogueEventData:
      IdEvent: 2
      DialogueName: NancyParker_TheGodfather
      IDCassette: 5
      IDPresent: 2
  - DialogueName: "\u0424\u0438\u0433\u0443\u0440\u043A\u0430 \u0441 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u043C
      \u0444\u0438\u043B\u044C\u043C\u0430"
    Id: 4
    NameCharacter: NancyParker
    Original_Title: The Godfather
    Present: '-'
    DialogLines:
    - Character: Ray
      IdNumber: 1
      Line: "Hello! Give me \u0424\u0438\u0433\u0443\u0440\u043A\u0430 \u0441 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u043C
        \u0444\u0438\u043B\u044C\u043C\u0430 "
      SoundLine: event:/Dialogs/NancyParker_TheGodfather/1
    - Character: Nancy
      IdNumber: 2
      Line: Ok
      SoundLine: event:/Dialogs/NancyParker_TheGodfather/2
    DialogueEventData:
      IdEvent: 2
      DialogueName: NancyParker_TheGodfather
      IDCassette: 2
      IDPresent: 3
