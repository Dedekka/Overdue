  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 237299343360
    m_Localized: "\u041E\u043F\u0440\u043E\u0441 \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F
      \u0434\u0435\u043C\u043E-\u0432\u0435\u0440\u0441\u0438\u0438 Sort the Tapes!"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092096
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E
      \u0441\u044B\u0433\u0440\u0430\u043B\u0438 \u0432 Sort the Tapes! \n\u041C\u044B
      \u0445\u043E\u0442\u0438\u043C \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0443
      \u043A\u0430\u0441\u0441\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0439, \u0430 \u043C\u0430\u0433\u0430\u0437\u0438\u043D
      \u2014 \u043C\u0435\u0441\u0442\u043E\u043C, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u0435\u0449\u0451 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432.
      \u041E\u043F\u0440\u043E\u0441 \u0437\u0430\u0439\u043C\u0451\u0442 \u043E\u043A\u043E\u043B\u043E
      5 \u043C\u0438\u043D\u0443\u0442 \u0438 \u043F\u043E\u043C\u043E\u0436\u0435\u0442
      \u043D\u0430\u043C \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u0442\u043E
      \u0443\u0436\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u043E,
      \u0430 \u0447\u0442\u043E \u0441\u0442\u043E\u0438\u0442 \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C
      \u043A \u0440\u0435\u043B\u0438\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 237337092097
    m_Localized: "\u0414\u0410\u041B\u0415\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092098
    m_Localized: "1. \u041A\u0430\u043A\u0438\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438
      \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B\u043E
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043F\u043E\u043D\u044F\u0442\u043D\u043E?\n\u041C\u043E\u0436\u043D\u043E
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 237337092099
    m_Localized: "\u041A\u0430\u043A \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0442\u044C
      \u0438 \u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u0430\u0441\u0441\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092100
    m_Localized: "\u041A\u0430\u043A \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u044C\u0441\u044F
      \u043C\u0435\u0436\u0434\u0443 \u043A\u0430\u0441\u0441\u0435\u0442\u0430\u043C\u0438
      \u0432 \u0440\u0443\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092101
    m_Localized: "\u041A\u0430\u043A \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u043D\u0443\u0436\u043D\u0443\u044E \u043F\u043E\u043B\u043A\u0443 \u043F\u043E
      \u0436\u0430\u043D\u0440\u0443 \u0438 \u043F\u043E\u0434\u0436\u0430\u043D\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092102
    m_Localized: "\u041A\u0430\u043A \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043E\u0431\u043B\u043E\u0436\u043A\u0443, \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u0438 \u0441\u0442\u0438\u043A\u0435\u0440 \u043A\u0430\u043A \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092103
    m_Localized: "\u041A\u0430\u043A \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0432\u0438\u0434\u0435\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043E\u0444\u043E\u043D\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092104
    m_Localized: "\u041A\u0430\u043A \u043E\u0442\u0432\u0435\u0447\u0430\u0442\u044C
      \u043D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092105
    m_Localized: "\u0413\u0434\u0435 \u0438\u0441\u043A\u0430\u0442\u044C \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0451\u043D\u043D\u044B\u0435
      \u043A\u043B\u0438\u0435\u043D\u0442\u0430\u043C\u0438 \u043A\u0430\u0441\u0441\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092106
    m_Localized: "\u041A\u0430\u043A \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0442\u044C
      \u043F\u043E\u0434\u0430\u0440\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092107
    m_Localized: "\u041A\u0430\u043A \u043C\u0435\u043D\u044F\u0442\u044C \u043C\u0443\u0437\u044B\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092108
    m_Localized: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u0432 \u0446\u0435\u043B\u043E\u043C
      \u0431\u044B\u043B\u043E \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092109
    m_Localized: "2. \u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043D\u044F\u0442\u043D\u043E
      \u0431\u044B\u043B\u043E, \u043A \u043A\u0430\u043A\u043E\u043C\u0443 \u043F\u043E\u0434\u0436\u0430\u043D\u0440\u0443
      \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A\u0430\u0441\u0441\u0435\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092110
    m_Localized: "\u041F\u043E\u0447\u0442\u0438 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043F\u043E\u043D\u0438\u043C\u0430\u043B(\u0430) \u0441\u0440\u0430\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092111
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u043B(\u0430)
      \u043F\u043E\u0441\u043B\u0435 \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u044F
      \u043E\u0431\u043B\u043E\u0436\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092112
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C
      \u0434\u043E\u043B\u0433\u043E \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092113
    m_Localized: "\u0427\u0430\u0441\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C
      \u0443\u0433\u0430\u0434\u044B\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092114
    m_Localized: "\u041F\u043E\u0447\u0442\u0438 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u043B(\u0430), \u043A\u0443\u0434\u0430
      \u0435\u0451 \u0441\u0442\u0430\u0432\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092115
    m_Localized: "3  \u0427\u0442\u043E \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E
      \u043F\u043E\u043C\u043E\u0433\u0430\u043B\u043E \u043F\u043E\u043D\u044F\u0442\u044C,
      \u043A\u0443\u0434\u0430 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u043A\u0430\u0441\u0441\u0435\u0442\u0430?\n\u041C\u043E\u0436\u043D\u043E
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432.  "
    m_Metadata:
      m_Items: []
  - m_Id: 237337092116
    m_Localized: "\u0418\u043B\u043B\u044E\u0441\u0442\u0440\u0430\u0446\u0438\u044F
      \u043D\u0430 \u043E\u0431\u043B\u043E\u0436\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092117
    m_Localized: "\u0426\u0432\u0435\u0442\u043E\u0432\u0430\u044F \u0433\u0430\u043C\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092118
    m_Localized: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0444\u0438\u043B\u044C\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092119
    m_Localized: "\u0421\u0442\u0438\u043A\u0435\u0440 \u043D\u0430 \u043A\u0430\u0441\u0441\u0435\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092120
    m_Localized: "\u0423\u0436\u0435 \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435
      \u0440\u044F\u0434\u043E\u043C \u0444\u0438\u043B\u044C\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092121
    m_Localized: "\u041F\u0440\u043E\u0441\u043C\u043E\u0442\u0440 \u043A\u0430\u0441\u0441\u0435\u0442\u044B
      \u043D\u0430 \u0432\u0438\u0434\u0435\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043E\u0444\u043E\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092122
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B(\u0430)
      \u0440\u0430\u0437\u043D\u044B\u0435 \u043F\u043E\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092123
    m_Localized: "4. \u041A\u0430\u043A\u043E\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F
      \u043F\u043E\u0434\u0436\u0430\u043D\u0440\u0430 \u0442\u0435\u0431\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u0431\u044B \u0431\u043E\u043B\u044C\u0448\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092124
    m_Localized: "\u0425\u043E\u0447\u0443, \u0447\u0442\u043E\u0431\u044B \u0431\u044B\u043B\u043E
      \u0437\u0430\u043C\u0435\u0442\u043D\u043E \u043F\u0440\u043E\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092125
    m_Localized: "\u041C\u043E\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092126
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0432 \u0441\u0430\u043C\u044B\u0439
      \u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092127
    m_Localized: "\u041C\u043E\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u043B\u043E\u0436\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092128
    m_Localized: "\u0425\u043E\u0447\u0443 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u043E\u0434\u043D\u043E\u0437\u043D\u0430\u0447\u043D\u044B\u0445
      \u043A\u0430\u0441\u0441\u0435\u0442 \u0438 \u0437\u0430\u0433\u0430\u0434\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092129
    m_Localized: "5. \u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0438\u044F\u0442\u043D\u043E
      \u0431\u044B\u043B\u043E \u0441\u0430\u043C\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0438 \u043A\u0430\u0441\u0441\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092130
    m_Localized: "\u0421\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092131
    m_Localized: "\u0421\u043A\u043E\u0440\u0435\u0435 \u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092132
    m_Localized: "\u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092133
    m_Localized: "\u041F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092134
    m_Localized: "\u041E\u0447\u0435\u043D\u044C \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092135
    m_Localized: "6. \u0425\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u043B\u0438
      \u0442\u0435\u0431\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C
      \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043A\u0430\u0441\u0441\u0435\u0442\u044B
      \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
      \u0434\u0435\u043C\u043E \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092136
    m_Localized: "\u0414\u0430, \u043E\u0447\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092137
    m_Localized: "\u0421\u043A\u043E\u0440\u0435\u0435 \u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092138
    m_Localized: "\u041D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D(\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092139
    m_Localized: "\u0421\u043A\u043E\u0440\u0435\u0435 \u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092140
    m_Localized: "\u041D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 237337092141
    m_Localized: "7. \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F(\u0430\u0441\u044C)
