  m_TableData:
  - m_Id: 425964814336
    m_Localized: "\u042D\u0442\u0430 \u043A\u0430\u0441\u0441\u0435\u0442\u0430 \u0441\u0442\u043E\u0438\u0442
      \u043D\u0435 \u043D\u0430 \u0441\u0432\u043E\u0435\u0439 \u043F\u043E\u043B\u043A\u0435.\n\n\u2022
      \u0418\u0437\u0443\u0447\u0438 \u043E\u0431\u043B\u043E\u0436\u043A\u0443,
      \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0438 \u0441\u0442\u0438\u043A\u0435\u0440,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u043F\u043E\u0434\u0436\u0430\u043D\u0440 \u043A\u0430\u0441\u0441\u0435\u0442\u044B.\n\u2022
      \u041D\u0430\u0439\u0434\u0438 \u0442\u0430\u0431\u043B\u0438\u0447\u043A\u0443
      \u043D\u0443\u0436\u043D\u043E\u0433\u043E \u043F\u043E\u0434\u0436\u0430\u043D\u0440\u0430
      \u2014 \u043D\u0430 \u043D\u0435\u0439 \u0442\u043E\u0436\u0435 \u0435\u0441\u0442\u044C
      \u0441\u0442\u0438\u043A\u0435\u0440 \u0434\u043B\u044F \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F.\n\u2022
      \u041F\u043E\u0441\u0442\u0430\u0432\u044C \u043A\u0430\u0441\u0441\u0435\u0442\u0443
      \u043D\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0443\u044E
      \u043F\u043E\u043B\u043A\u0443.\n\n\u041D\u0430 \u043D\u0443\u0436\u043D\u043E\u0439
      \u043F\u043E\u043B\u043A\u0435 \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C
      \u043B\u044E\u0431\u043E\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E. \u042D\u0444\u0444\u0435\u043A\u0442 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0438
      \u0438 \u0437\u0432\u0443\u043A \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u044F\u0442
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0443\u044E \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443.
      \u0418\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u2014 \u043A\u0430\u0441\u0441\u0435\u0442\u044B
      \xAB\u0421\u0430\u043D\u0441\u0435\u0442-\u041A\u0440\u0438\u043A\xBB: \u0434\u043B\u044F
      \u043D\u0438\u0445 \u0432\u0430\u0436\u0435\u043D \u043F\u043E\u0440\u044F\u0434\u043E\u043A.\""
    m_Metadata:
      m_Items: []
  - m_Id: 2686895996928
    m_Localized: "\u0422\u0423\u0422\u041E\u0420\u0418\u0410\u041B"
    m_Metadata:
      m_Items: []
  - m_Id: 1129744569155584
    m_Localized: "\u041A\u0410\u041A \u041D\u0410\u0419\u0422\u0418 \u041D\u0423\u0416\u041D\u0423\u042E
      \u041F\u041E\u041B\u041A\u0423 \u0414\u041B\u042F \u041A\u0410\u0421\u0421\u0415\u0422\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 1129744598515712
    m_Localized: "\u041A\u0410\u041A \u0423\u0417\u041D\u0410\u0422\u042C \u0416\u0410\u041D\u0420
      \u041A\u0410\u0421\u0421\u0415\u0422\u042B \u0421 \u041F\u041E\u041C\u041E\u0429\u042C\u042E
      \u0412\u0418\u0414\u0415\u041E\u041C\u0410\u0413\u041D\u0418\u0422\u041E\u0424\u041E\u041D\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 1129744598515713
    m_Localized: "\u0412\u0438\u0434\u0435\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043E\u0444\u043E\u043D
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0441\u0443\u0437\u0438\u0442\u044C
      \u043F\u043E\u0438\u0441\u043A \u043D\u0443\u0436\u043D\u043E\u0439 \u043F\u043E\u043B\u043A\u0438.\n\n\u2022
      \u0412\u0441\u0442\u0430\u0432\u044C \u043A\u0430\u0441\u0441\u0435\u0442\u0443
      \u0432 \u0432\u0438\u0434\u0435\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043E\u0444\u043E\u043D.\r\n\u2022
      \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
      \u0438 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0439 \u043F\u043E\u044F\u0432\u0438\u0432\u0448\u0435\u0435\u0441\u044F
      \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0436\u0430\u043D\u0440\u0430.\r\n\u2022
      \u041D\u0430\u0439\u0434\u0438 \u0441\u0435\u043A\u0446\u0438\u044E \u044D\u0442\u043E\u0433\u043E
      \u0436\u0430\u043D\u0440\u0430, \u0437\u0430\u0442\u0435\u043C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438
      \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u043F\u043E\u0434\u0436\u0430\u043D\u0440
      \u043F\u043E \u043E\u0431\u043B\u043E\u0436\u043A\u0435, \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044E
      \u0438 \u0441\u0442\u0438\u043A\u0435\u0440\u0443 \u043A\u0430\u0441\u0441\u0435\u0442\u044B.\r\n\n\u0412\u0438\u0434\u0435\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043E\u0444\u043E\u043D
      \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0436\u0430\u043D\u0440. \u041F\u043E\u0434\u0436\u0430\u043D\u0440 \u0438
      \u043D\u0443\u0436\u043D\u0443\u044E \u043F\u043E\u043B\u043A\u0443 \u0442\u0435\u0431\u0435
      \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u043D\u0430\u0439\u0442\u0438
      \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1129744598515714
    m_Localized: "\u041A\u0410\u041A \u041F\u041E\u041B\u0423\u0427\u0410\u0422\u042C
      \u0412\u041E\u0417\u0412\u0420\u0410\u0429\u0401\u041D\u041D\u042B\u0415 \u041A\u041B\u0418\u0415\u041D\u0422\u0410\u041C\u0418
      \u041A\u0410\u0421\u0421\u0415\u0422\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 1129744598515715
    m_Localized: "\u041A\u043B\u0438\u0435\u043D\u0442\u044B \u0437\u0432\u043E\u043D\u044F\u0442
      \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442 \u043A\u0430\u0441\u0441\u0435\u0442\u044B
      \u043F\u043E \u043C\u0435\u0440\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
      \u0442\u044B \u043D\u0430\u0432\u043E\u0434\u0438\u0448\u044C \u043F\u043E\u0440\u044F\u0434\u043E\u043A.\n\n\u2022
      \u041A\u043E\u0433\u0434\u0430 \u0437\u0430\u0437\u0432\u043E\u043D\u0438\u0442
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D, \u043E\u0442\u0432\u0435\u0442\u044C
      \u0438 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438 \u0441 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u043C.\r\n\u2022
      \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439 \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
      \u043A\u0430\u0441\u0441\u0435\u0442\u044B.\r\n\u2022 \u041A\u043E\u0433\u0434\u0430
      \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u0432\u043E\u0437\u0432\u0440\u0430\u0442,
      \u0437\u0430\u0431\u0435\u0440\u0438 \u043A\u0430\u0441\u0441\u0435\u0442\u0443
      \u0438\u0437 \u043A\u043E\u0440\u043E\u0431\u043A\u0438 \u0443 \u0434\u0432\u0435\u0440\u0438
      \u0438 \u043D\u0430\u0439\u0434\u0438 \u0434\u043B\u044F \u043D\u0435\u0451
      \u043D\u0443\u0436\u043D\u0443\u044E \u043F\u043E\u043B\u043A\u0443.\r\n\n\u041D\u043E\u0432\u044B\u0435
      \u0441\u043E\u0431\u044B\u0442\u0438\u044F \u0441\u0432\u044F\u0437\u0430\u043D\u044B
      \u0441 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445
      \u043A\u0430\u0441\u0441\u0435\u0442. \u0427\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C
      \u0437\u0432\u043E\u043D\u043A\u0438, \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u044B
      \u0438 \u043F\u043E\u0434\u0430\u0440\u043A\u0438, \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439
      \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1129744598515716
    m_Localized: "\u041A\u0410\u041A \u0423\u041A\u0420\u0410\u0421\u0418\u0422\u042C
      \u041F\u0420\u041E\u041A\u0410\u0422 \u041F\u041E\u0414\u0410\u0420\u041A\u0410\u041C\u0418
      \u041E\u0422 \u041A\u041B\u0418\u0415\u041D\u0422\u041E\u0412"
    m_Metadata:
      m_Items: []
  - m_Id: 1129744598515717
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u043A\u043B\u0438\u0435\u043D\u0442\u044B
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 \u043F\u043E\u0434\u0430\u0440\u043A\u0438,
      \u0447\u0442\u043E\u0431\u044B \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0440\u043E\u043A\u0430\u0442
      \u0443\u044E\u0442\u043D\u0435\u0435.\n\n\u2022 \u041F\u043E\u0434\u0431\u0435\u0440\u0438
      \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u0440\u044F\u0434\u043E\u043C \u0441
      \u0434\u0432\u0435\u0440\u044C\u044E.\r\n\u2022 \u041D\u0430\u0439\u0434\u0438
      \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
      \u0434\u043B\u044F \u043D\u0435\u0433\u043E.\r\n\u2022 \u041E\u0442\u043D\u0435\u0441\u0438
      \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u0442\u0443\u0434\u0430 \u0438
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438 \u0435\u0433\u043E.\n\n\u0423
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043F\u043E\u0434\u0430\u0440\u043A\u0430
      \u0435\u0441\u0442\u044C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E. \u041F\u043E\u0441\u043B\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
      \u0435\u0433\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C
      \u0438\u043B\u0438 \u0443\u0431\u0440\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1129744598515718
    m_Localized: "\u041A\u0410\u041A \u041C\u0415\u041D\u042F\u0422\u042C \u041C\u0423\u0417\u042B\u041A\u0423
      \u0412 \u041F\u0420\u041E\u041A\u0410\u0422\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 1129744598515719
    m_Localized: "\u0410\u0443\u0434\u0438\u043E\u043A\u0430\u0441\u0441\u0435\u0442\u044B
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C
      \u043C\u0443\u0437\u044B\u043A\u0443 \u0434\u043B\u044F \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0438.\n\n\u2022
      \u0412\u044B\u0431\u0435\u0440\u0438 \u0430\u0443\u0434\u0438\u043E\u043A\u0430\u0441\u0441\u0435\u0442\u0443
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0435 \u043D\u0430\u0434 \u043C\u0430\u0433\u043D\u0438\u0442\u043E\u0444\u043E\u043D\u043E\u043C.\r\n\u2022
      \u041D\u0430\u0436\u043C\u0438 Play \u043D\u0430 \u043C\u0430\u0433\u043D\u0438\u0442\u043E\u0444\u043E\u043D\u0435,
      \u0447\u0442\u043E\u0431\u044B \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0443\u044E \u043C\u0443\u0437\u044B\u043A\u0443.\r\n\n\u0418\u0449\u0438
      \u043D\u043E\u0432\u044B\u0435 \u0430\u0443\u0434\u0438\u043E\u043A\u0430\u0441\u0441\u0435\u0442\u044B
      \u0432 \u043F\u0440\u043E\u043A\u0430\u0442\u0435. \u041D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0435
      \u043A\u0430\u0441\u0441\u0435\u0442\u044B \u043F\u043E\u044F\u0432\u044F\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0435 \u043D\u0430\u0434 \u043C\u0430\u0433\u043D\u0438\u0442\u043E\u0444\u043E\u043D\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1129744598515720
    m_Localized: "\u041A\u0410\u041A \u0420\u0410\u0421\u0421\u0422\u0410\u0412\u0418\u0422\u042C
      \u0421\u0415\u0420\u0418\u0418 SUNSET CREEK \u041F\u041E \u041F\u041E\u0420\u042F\u0414\u041A\u0423"
    m_Metadata:
      m_Items: []
  - m_Id: 1129744598515721
    m_Localized: "\u0421\u0435\u0440\u0438\u0438 Sunset Creek \u043D\u0443\u0436\u043D\u043E
      \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432 \u0441\u044E\u0436\u0435\u0442\u043D\u043E\u043C
      \u043F\u043E\u0440\u044F\u0434\u043A\u0435.\n\n\u2022 \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
      \u043A\u0430\u0441\u0441\u0435\u0442\u044B Sunset Creek \u043D\u0430 \u0432\u0438\u0434\u0435\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043E\u0444\u043E\u043D\u0435.\r\n\u2022
      \u0421\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u044C \u0441\u043E\u0431\u044B\u0442\u0438\u044F
      \u0441\u0435\u0440\u0438\u0439, \u0447\u0442\u043E\u0431\u044B \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u0438\u0445 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C.\r\n\u2022
      \u041F\u043E\u0441\u0442\u0430\u0432\u044C \u043A\u0430\u0436\u0434\u0443\u044E
      \u043A\u0430\u0441\u0441\u0435\u0442\u0443 \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
      \u0441\u043B\u043E\u0442 \u043D\u0430 \u0441\u0442\u0435\u043B\u043B\u0430\u0436\u0435
      \u0441\u0435\u0440\u0438\u0430\u043B\u0430.\r\n\n\u042D\u0442\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u043A\u0430\u0441\u0441\u0435\u0442\u044B, \u0434\u043B\u044F \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0432\u0430\u0436\u0435\u043D \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439
      \u0441\u043B\u043E\u0442. \u0415\u0441\u043B\u0438 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u0435\u0448\u044C\u0441\u044F
      \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435, \u043F\u0435\u0440\u0435\u0441\u043C\u043E\u0442\u0440\u0438
      \u0441\u0435\u0440\u0438\u0438 \u043D\u0430 \u0432\u0438\u0434\u0435\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043E\u0444\u043E\u043D\u0435."
