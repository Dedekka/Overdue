--- !u!114 &2099770980150670108
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3782461104849089153}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041A\u0430\u0436\u0434\u0430\u044F VHS-\u043A\u0430\u0441\u0441\u0435\u0442\u0430
    \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u043C\u0443
    \u043F\u043E\u0434\u0436\u0430\u043D\u0440\u0443. \L\L\u0412\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0438\u0437\u0443\u0447\u0438 \u043E\u0431\u043B\u043E\u0436\u043A\u0443, \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
    \u0438 \u0441\u0442\u0438\u043A\u0435\u0440 \u2014 \u043E\u043D\u0438 \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0443\u0442,
    \u043A\u0443\u0434\u0430 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F
    \u043A\u0430\u0441\u0441\u0435\u0442\u0430.\r\L\n\u041E\u043F\u0440\u0435\u0434\u0435\u043B\u0438
    \u043F\u043E\u0434\u0436\u0430\u043D\u0440, \u043D\u0430\u0439\u0434\u0438 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0443\u044E
    \u043F\u043E\u043B\u043A\u0443 \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u044C
    \u043A\u0430\u0441\u0441\u0435\u0442\u0443 \u043D\u0430 \u043C\u0435\u0441\u0442\u043E."
