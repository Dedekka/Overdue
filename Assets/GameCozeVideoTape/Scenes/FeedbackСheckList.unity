    m_Modifications:
    - target: {fileID: 810380461104356089, guid: 49689a48a6d79d1428fd8a85d9281c91, type: 3}
      propertyPath: m_text
      value: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0441\u044B\u0433\u0440\u0430\u043B\u0438
        \u0432 Sort the Tapes! \n\r\n\u041C\u044B \u0445\u043E\u0442\u0438\u043C
        \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0443
        \u043A\u0430\u0441\u0441\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0439, \u0430 \u043C\u0430\u0433\u0430\u0437\u0438\u043D
        \u2014 \u043C\u0435\u0441\u0442\u043E\u043C, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
        \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
        \u0435\u0449\u0451 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0447\u0430\u0441\u043E\u0432. \u041E\u043F\u0440\u043E\u0441 \u0437\u0430\u0439\u043C\u0451\u0442
        \u043E\u043A\u043E\u043B\u043E 5 \u043C\u0438\u043D\u0443\u0442 \u0438 \u043F\u043E\u043C\u043E\u0436\u0435\u0442
        \u043D\u0430\u043C \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u0442\u043E
        \u0443\u0436\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u043E,
        \u0430 \u0447\u0442\u043E \u0441\u0442\u043E\u0438\u0442 \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C
        \u043A \u0440\u0435\u043B\u0438\u0437\u0443.\r\n"
      objectReference: {fileID: 0}
