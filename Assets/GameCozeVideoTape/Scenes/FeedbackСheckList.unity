    - target: {fileID: 1211225969811042895, guid: 5c11a60cb5716fb429cede631d45d3ac, type: 3}
      propertyPath: m_text
      value: "12. \u041A\u0430\u043A\u0438\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
        \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u0442\u0435\u0431\u0435
        \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0433\u043E \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
        \u0431\u044B \u0432\u0438\u0434\u0435\u0442\u044C \u0432 \u043F\u043E\u043B\u043D\u043E\u0439
        \u0438\u0433\u0440\u0435? \u041C\u043E\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C
        \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E."
      objectReference: {fileID: 0}
